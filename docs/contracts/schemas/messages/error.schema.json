{
  "$id": "https://energyshark.internal/schemas/messages/error.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "error — rechazo de OPERACIÓN, mensaje bien formado (central -> ciudad)",
  "description": "Siempre precedido de un ack (el mensaje sí fue recibido). Nunca se hace ack de un error ni error de un error.",
  "allOf": [
    { "$ref": "../envelope.schema.json" },
    { "if": { "properties": { "reason": { "const": "CYCLE_UNKNOWN" } } }, "then": { "properties": { "code": { "const": 404 } } } },
    { "if": { "properties": { "reason": { "const": "CYCLE_EXPIRED" } } }, "then": { "properties": { "code": { "const": 410 } } } },
    { "if": { "properties": { "reason": { "const": "PRICE_ABOVE_CAP" } } }, "then": { "properties": { "code": { "const": 422 } }, "required": ["data"], "properties": { "data": { "required": ["cap"] } } } },
    { "if": { "properties": { "reason": { "const": "OVER_CAPACITY" } } }, "then": { "properties": { "code": { "const": 409 } }, "required": ["data"], "properties": { "data": { "required": ["spare"] } } } }
  ],
  "type": "object",
  "properties": {
    "type": { "const": "error" },
    "sender": { "const": "central" },
    "cycleId": { "type": "string" },
    "reason": { "type": "string", "enum": ["CYCLE_UNKNOWN", "CYCLE_EXPIRED", "PRICE_ABOVE_CAP", "OVER_CAPACITY"] },
    "code": { "type": "integer", "enum": [404, 409, 410, 422] },
    "data": {
      "type": "object",
      "required": ["target", "message"],
      "properties": {
        "target": { "type": "string", "format": "uuid", "description": "msgId del mensaje que causó el error." },
        "message": { "type": "string" },
        "cap": { "type": "number", "description": "Solo en PRICE_ABOVE_CAP: round2(1.05*generationCost)." },
        "spare": { "type": "number", "description": "Solo en OVER_CAPACITY: energía vendible restante." }
      }
    }
  },
  "required": ["type", "sender", "reason", "code", "data"]
}
