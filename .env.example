# Copiar a .env (gitignored) y completar. Usado por docker-compose.yml para provisionar
# el servicio `db` — debe coincidir con DB_USER/DB_PASSWORD/DB_NAME de master/.env y connector/.env.
DB_USER=
DB_PASSWORD=
DB_NAME=

# Imágenes (docs/deploy.md). Vacías en local: se construyen como energyshark/*:latest.
# En el EC2: ECR_REGISTRY=<cuenta>.dkr.ecr.<región>.amazonaws.com e IMAGE_TAG = el tag publicado.
ECR_REGISTRY=
IMAGE_TAG=
