# Copiar a .env (gitignored) y completar. Debe coincidir con el .env de la raíz.
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_HOST=db
DB_PORT=5432
DB_SSL=false

# Auth0 (decisiones fundacionales §1): los mismos valores que el JWT authorizer del API Gateway.
# Obligatorias en producción: sin ellas master no arranca. En local, vacías = API sin auth.
AUTH0_ISSUER_BASE_URL=
AUTH0_AUDIENCE=

# New Relic APM (decisiones fundacionales §5, docs/monitoreo.md). Sin licencia el agente no se carga.
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=energyshark-master

# Solo producción (NODE_ENV=production): true muestra el SQL de Sequelize en el log. Apagado por defecto.
DB_LOGGING=
