# Copiar a .env (gitignored) y completar con valores reales. Nunca commitear .env.

# RabbitMQ — credenciales del curso para esta ciudad.
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_VHOST=
# Exchange por el que se publica a la central (ack/nack/negotiation-report). Obligatorio.
RABBITMQ_EXCHANGE=
# Routing key de la central (ADR-001, addendum topología). Opcional, por defecto `central`.
RABBITMQ_CENTRAL_ROUTING_KEY=central

# Postgres compartido con `master` (mismas variables que master/src/config/config.js).
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_HOST=db
DB_PORT=5432
DB_SSL=false

# Periodo del loop que publica outbox_messages, en ms. Opcional, por defecto 1000.
OUTBOX_TICK_MS=

# SOLO PRUEBAS LOCALES, nunca en producción: divide todas las duraciones del ciclo (ventana 20 min,
# cierre 5 min, consumo 2 h, tick del scheduler 30 s). Con 60, un minuto del protocolo dura 1 s.
CYCLE_TIME_SCALE=
